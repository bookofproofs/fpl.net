def pred Impl(f, g: pred) /*a*/ infix "⇒" 0 {impl(f,g)} 
inf MP { dec p,q: pred; pre: p, p ⇒ q con: q } /*a*/

proof T$1 {dec f,x:pred; 1: x 2: x ⇒ (f ⇒ f) 3. 2,1, byinf/*a*/ MP |- (f ⇒ f) }

def class FieldPowerN: Set { ctor FieldPowerN(x:obj, y:pred) { dec base.Obj() ; } /*a*/ property pred T() { true } }