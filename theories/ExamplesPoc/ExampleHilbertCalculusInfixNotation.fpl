// Example from D. Hoffmann, "Theoretische Informatik", 3rd. ed. p. 99

// auxiliary definitions
def pred Impl(f, g: pred) infix "⇒" 0
{
    impl(f,g)
}


// weakening rule
axiom A1
{
    dec f, g: pred;
    f ⇒ (g ⇒ f)
}

// impl distributive
axiom A2 
{
    dec f, g, h: pred;
    (f ⇒ (g ⇒ h)) ⇒ ((f ⇒ g) ⇒ (f ⇒ h))
}

// contraposition
axiom A3 
{
    dec f, g: pred;
    (¬f ⇒ ¬g) ⇒ (g ⇒ f)
}

inf ModusPonens
{
    dec f, g: pred;
    pre:
        f, f ⇒ g 
    con:
        g
}

theorem Example1
{
    dec a:pred;
    a ⇒ a
}

proof Example1$1
{
    // Direct Proof
    // Strategy: Assume that the premise is true, then prove that the conclusion also must be true.
    
    1. byax A2 
    |- (a ⇒ ((a ⇒ a) ⇒ a)) ⇒ ((a ⇒ (a ⇒ a)) ⇒ (a ⇒ a))

    2. byax A1 
    |- (a ⇒ ((a ⇒ a) ⇒  a))

    3. 1, 2, byinf ModusPonens 
    |- (a ⇒ (a ⇒ a)) ⇒ (a ⇒ a)

    4. byax A1 
    |- a ⇒ (a ⇒ a)

    5. 3, 4, byinf ModusPonens 
    |- a ⇒ a

    qed
}


