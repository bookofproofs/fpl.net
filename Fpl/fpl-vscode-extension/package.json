{
    "name": "fpl-vscode-extension",
    "displayName": "FPL (Formal Proving Language)",
    "description": "Write mathematics independently of natural languages.",
    "icon": "images/logo.png",
    "version": "5.1.0",
    "repository": "https://github.com/bookofproofs/fpl.net",
    "publisher": "bookofproofs",
    "license": "MIT",
    "engines": {
        "vscode": "^1.81.0"
    },
    "categories": [
        "Programming Languages",
        "Education",
        "Other"
    ],
    "keywords": [
        "mathematics",
        "logic",
        "formal",
        "language",
        "proving"
    ],
    "main": "./out/extension.js",
    "activationEvents": [
        "workspaceContains:**/*.fpl"
    ],
    "contributes": {
        "languages": [
            {
                "id": "fpl",
                "aliases": [
                    "Formal Proving Language",
                    "fpl",
                    "FPL"
                ],
                "extensions": [
                    ".fpl"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "fpl",
                "scopeName": "source.fpl",
                "path": "./syntaxes/fpl.tmLanguage.json"
            }
        ],
        "themes": [
            {
                "label": "dark",
                "uiTheme": "vs-dark",
                "path": "./themes/d-color-theme.json"
            }
        ],
        "commands": [
            {
                "command": "fpl-vscode-extension.helloWorld",
                "title": "Hello World"
            },
            {
                "command": "extension.openFileAtPosition",
                "title": "Open File at Position"
            },
            {
                "command": "fpl-vscode-extension.showWebview",
                "title": "Show Valid Statements"
            },
            {
                "command": "fpl-vscode-extension.refreshTheories",
                "title": "Refresh FPL Theories",
                "icon": "$(refresh)"
            }
        ],
        "submenus": [
            {
                "id": "fpl-vscode-extension.fplMenu",
                "label": "FPL"
            }
        ],
        "views": {
            "explorer": [
                {
                    "id": "fplTheories",
                    "name": "FPL Theories",
                    "icon": "./images/logo.png"
                }
            ]
        },
        "configuration": {
            "title": "FPL",
            "properties": {
                "fplExtension.entryPoint": {
                    "type": "string",
                    "default": "MyFplTheory.fpl",
                    "description": "The fpl file containing the top entry point of your mathematical theory."
                },
                "fplExtension.textEditor.setting1": {
                    "type": "number",
                    "default": 1,
                    "description": "Test number."
                },
                "fplExtension.textEditor.setting2": {
                    "type": "boolean",
                    "default": true,
                    "description": "Test boolean."
                }
            }
        },
        "menus": {
            "editor/context": [
                {
                    "submenu": "fpl-vscode-extension.fplMenu",
                    "when": "resourceExtname == .fpl",
                    "group": "navigation"
                }
            ],
            "fpl-vscode-extension.fplMenu": [
                {
                    "command": "fpl-vscode-extension.showWebview",
                    "group": "navigation"
                }
            ],
            "editor/title": [
                {
                    "command": "fpl-vscode-extension.showWebview",
                    "when": "resourceExtname == .fpl",
                    "group": "navigation"
                }
            ],
            "view/title": [
                {
                    "command": "fpl-vscode-extension.refreshTheories",
                    "when": "view == fplTheories",
                    "group": "navigation"
                }
            ]
        }
    },
    "scripts": {
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "sync-version": "node ./scripts/sync-version.js",
        "sync-vscode-changelog": "node ./scripts/sync-vscode-changelog.js",
        "copy-ls-dlls": "node ./scripts/copyLsDlls.js",
        "vscode:prepublish": "npm run sync-version && npm run sync-vscode-changelog && npm run copy-ls-dlls && npm run compile",
        "lint": "eslint src --ext ts",
        "pretest": "npm run compile && npm run lint",
        "test": "node ./out/test/runTest.js"
    },
    "dependencies": {
        "katex": "^0.17.0",
        "vscode-languageclient": "latest"
    },
    "devDependencies": {
        "typescript": "^5.4.0",
        "@types/node": "^20.0.0",
        "@types/vscode": "^1.81.0",
        "eslint": "^8.57.0",
        "@typescript-eslint/parser": "^7.0.0",
        "@typescript-eslint/eslint-plugin": "^7.0.0"
    },
    "extensionDependencies": [
        "ms-dotnettools.vscode-dotnet-runtime"
    ]
}
